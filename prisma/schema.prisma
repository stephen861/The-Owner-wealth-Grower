// Owner Wealth Grower — Travel CRM data model
// Tracks timeshare ownership, points & membership benefits,
// reservations/trips, and fees & finances.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A single owned timeshare contract / membership.
model Timeshare {
  id              String   @id @default(cuid())
  name            String // friendly name, e.g. "Bonnet Creek 2BR"
  brand           String? // e.g. "Wyndham", "Marriott", "Hilton"
  resort          String? // resort / property name
  location        String? // city, state, country
  ownershipType   String   @default("POINTS") // POINTS | DEEDED_WEEK | FRACTIONAL | RTU
  contractNumber  String?
  memberNumber    String?
  deededWeek      String? // e.g. "Week 26" for fixed-week ownership
  unitType        String? // e.g. "2BR Deluxe"
  ownershipShare  Float? // ownership percentage (0-100), for fractional
  annualPoints    Int? // base annual point allotment for this contract
  useYear         String? // ANNUAL | EVEN | ODD or a month for the use-year start
  purchaseDate    DateTime?
  purchasePrice   Float?
  active          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pointsAccounts      PointsAccount[]
  benefits            Benefit[]
  reservations        Reservation[]
  fees                Fee[]
  exchangeMemberships ExchangeMembership[]
  exchangeDeposits    ExchangeDeposit[]
}

// An external exchange network or travel-benefit membership the owner
// belongs to: RCI, Interval International, Westgate Cruise & Travel, etc.
// Optionally linked to the owned timeshare that feeds it.
model ExchangeMembership {
  id            String   @id @default(cuid())
  name          String // friendly name, e.g. "RCI Weeks"
  network       String   @default("RCI") // RCI | INTERVAL | WESTGATE_TRAVEL | DAE | SFX | OTHER
  memberNumber  String?
  tier          String? // e.g. "RCI Platinum", "Interval Gold"
  timeshareId   String? // the owned contract this membership is tied to
  timeshare     Timeshare? @relation(fields: [timeshareId], references: [id], onDelete: SetNull)
  joinDate      DateTime?
  expiresAt     DateTime?
  membershipFee Float? // annual membership fee
  active        Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deposits ExchangeDeposit[]
  perks    MembershipPerk[]
}

// A reward, credit, discount or perk attached to a membership.
// Tracks a dollar value/balance (e.g. Costco Executive 2% reward,
// Sam's Cash, a travel credit) and how much has been used.
model MembershipPerk {
  id           String   @id @default(cuid())
  membershipId String
  membership   ExchangeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  name         String // e.g. "Executive 2% Reward", "Sam's Cash", "Travel credit"
  category     String   @default("REWARD") // REWARD | CREDIT | DISCOUNT | PERK
  value        Float? // total dollar value / balance (null for non-monetary perks)
  used         Float    @default(0) // amount redeemed so far
  expiresAt    DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A week or block of points deposited into an exchange network that can
// be traded for other stays. Tracks trading power and expiration — the
// things owners most often lose track of.
model ExchangeDeposit {
  id           String   @id @default(cuid())
  membershipId String
  membership   ExchangeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  timeshareId  String? // source ownership the deposit came from
  timeshare    Timeshare? @relation(fields: [timeshareId], references: [id], onDelete: SetNull)
  depositType  String   @default("WEEK") // WEEK | POINTS
  description  String? // e.g. "2025 Week 26 — Bonnet Creek 2BR"
  tradingPower Float? // trading power / exchange value
  pointsValue  Int? // for points-based deposits
  depositDate  DateTime?
  expiresAt    DateTime? // when the deposit / trade credit expires
  status       String   @default("AVAILABLE") // AVAILABLE | USED | EXPIRED
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Points balance for a given use-year on a timeshare.
// Captures the full lifecycle: allotted, used, banked, borrowed, expiring.
model PointsAccount {
  id           String   @id @default(cuid())
  timeshareId  String
  timeshare    Timeshare @relation(fields: [timeshareId], references: [id], onDelete: Cascade)
  useYear      Int // calendar year the points belong to, e.g. 2026
  allotted     Int      @default(0) // points granted this use year
  used         Int      @default(0) // points already redeemed
  banked       Int      @default(0) // points banked/saved into a future year
  borrowed     Int      @default(0) // points borrowed from a future year
  expiresAt    DateTime? // when remaining points expire
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([timeshareId, useYear])
}

// A membership benefit / perk tied to a timeshare or membership tier.
model Benefit {
  id           String   @id @default(cuid())
  timeshareId  String
  timeshare    Timeshare @relation(fields: [timeshareId], references: [id], onDelete: Cascade)
  name         String // e.g. "Free guest certificates", "Lounge access"
  category     String   @default("PERK") // TIER | PERK | DISCOUNT | CREDIT | UPGRADE
  tier         String? // e.g. "Gold", "Platinum"
  description  String?
  totalAllowance Int? // e.g. 3 guest certs per year (null = unlimited / n.a.)
  usedAllowance  Int    @default(0)
  expiresAt    DateTime?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A booked or planned stay/trip.
model Reservation {
  id                 String   @id @default(cuid())
  timeshareId        String?
  timeshare          Timeshare? @relation(fields: [timeshareId], references: [id], onDelete: SetNull)
  contactId          String? // the client this stay was booked for
  contact            Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId             String? // the deal this booking fulfils
  deal               Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)
  resort             String // where the stay is
  location           String?
  checkIn            DateTime
  checkOut           DateTime
  guests             Int      @default(1)
  unitType           String?
  confirmationNumber String?
  pointsUsed         Int      @default(0)
  cashCost           Float    @default(0)
  clientCharge       Float    @default(0) // what the client paid you
  commission         Float    @default(0) // your earnings on this booking
  status             String   @default("CONFIRMED") // PLANNED | CONFIRMED | COMPLETED | CANCELLED
  guestName          String? // when booked for someone else (guest certificate)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// A financial obligation tied to a timeshare: maintenance fees,
// special assessments, club dues, loan payments, etc.
model Fee {
  id           String   @id @default(cuid())
  timeshareId  String
  timeshare    Timeshare @relation(fields: [timeshareId], references: [id], onDelete: Cascade)
  type         String   @default("MAINTENANCE") // MAINTENANCE | SPECIAL_ASSESSMENT | CLUB_DUES | LOAN | TAX | OTHER
  description  String?
  amount       Float
  dueDate      DateTime
  paid         Boolean  @default(false)
  paidDate     DateTime?
  recurrence   String   @default("ANNUAL") // ONCE | MONTHLY | QUARTERLY | ANNUAL
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Client relationship layer: the people you sell to and serve, the deals in
// flight, and every touchpoint/follow-up owed to them.
// ---------------------------------------------------------------------------

// A person or household in your book of business: client, lead, partner or
// guest traveller.
model Contact {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  company        String?
  type           String   @default("LEAD") // LEAD | CLIENT | TENANT | OWNER | PARTNER | GUEST
  status         String   @default("NEW") // NEW | CONTACTED | QUALIFIED | ACTIVE | DORMANT | LOST
  source         String? // REFERRAL | PRESENTATION | SOCIAL | WEBSITE | REPEAT | OTHER
  city           String?
  state          String?
  tags           String? // comma-separated, e.g. "cruise,family,VIP"
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deals            Deal[]
  activities       Activity[]
  reservations     Reservation[]
  ownedProperties  Property[] @relation("PropertyOwner")
  leases           Lease[]    @relation("LeaseTenant")
}

// A revenue opportunity moving through the sales pipeline.
model Deal {
  id             String   @id @default(cuid())
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title          String // e.g. "Cancun 7-night — Ramirez family"
  stage          String   @default("NEW") // NEW | QUALIFYING | PROPOSAL | NEGOTIATION | WON | LOST
  value          Float    @default(0) // gross booking / sale value
  commissionRate Float    @default(0) // percent of value you keep (0-100)
  probability    Int      @default(25) // 0-100, used for the weighted forecast
  expectedCloseAt DateTime?
  closedAt       DateTime?
  lostReason     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activities   Activity[]
  reservations Reservation[]
}

// A logged touchpoint or an open task/follow-up, optionally tied to a
// contact and/or a deal.
model Activity {
  id          String   @id @default(cuid())
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  type        String   @default("NOTE") // CALL | EMAIL | TEXT | MEETING | NOTE | TASK
  subject     String
  body        String?
  dueAt       DateTime? // set for follow-ups / tasks
  done        Boolean  @default(false)
  doneAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Property management: the Rent Manager replacement. Properties hold units,
// units hold leases, leases carry a charge/payment ledger, and work orders +
// expenses roll up into owner statements.
// ---------------------------------------------------------------------------

// A building or address you own or manage. Owners are Contacts of type OWNER.
model Property {
  id            String   @id @default(cuid())
  name          String // friendly name, e.g. "Maple Street Duplex"
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  zip           String?
  type          String   @default("SINGLE_FAMILY") // SINGLE_FAMILY | MULTI_FAMILY | APARTMENT | COMMERCIAL | ALF | SHORT_TERM
  ownerId       String? // the Contact who owns it (you, or a managed client)
  owner         Contact? @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  managementFeeRate Float @default(0) // percent of collected rent you keep
  purchaseDate  DateTime?
  purchasePrice Float?
  marketValue   Float?
  mortgageBalance Float?
  active        Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  units      Unit[]
  workOrders WorkOrder[]
  expenses   Expense[]
}

// A rentable space inside a property. Single-family homes get one unit.
model Unit {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label      String // "101", "A", "Main"
  beds       Float    @default(0)
  baths      Float    @default(0)
  sqft       Int?
  marketRent Float    @default(0) // asking rent when vacant
  status     String   @default("VACANT") // VACANT | OCCUPIED | NOTICE | DOWN
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leases     Lease[]
  workOrders WorkOrder[]
  expenses   Expense[]

  @@unique([propertyId, label])
}

// A tenancy: one unit, one primary tenant (a Contact), for a term.
model Lease {
  id            String   @id @default(cuid())
  unitId        String
  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Contact  @relation("LeaseTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime?
  rentAmount    Float    @default(0) // recurring rent per period
  rentDueDay    Int      @default(1) // day of month rent posts
  depositAmount Float    @default(0)
  depositHeld   Float    @default(0)
  lateFeeAmount Float    @default(0)
  lateFeeAfterDay Int    @default(5) // grace period in days
  status        String   @default("ACTIVE") // PENDING | ACTIVE | NOTICE | ENDED | EVICTION
  moveInDate    DateTime?
  moveOutDate   DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  charges  Charge[]
  payments Payment[]
}

// Money owed on a lease: rent posted for a period, a late fee, a utility
// rebill, a damage charge.
model Charge {
  id          String   @id @default(cuid())
  leaseId     String
  lease       Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  type        String   @default("RENT") // RENT | LATE_FEE | UTILITY | DEPOSIT | REPAIR | OTHER
  description String?
  amount      Float
  dueDate     DateTime
  period      String? // "2026-09" for the rent month this charge covers
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leaseId, period, type])
}

// Money received against a lease.
model Payment {
  id         String   @id @default(cuid())
  leaseId    String
  lease      Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  amount     Float
  receivedAt DateTime @default(now())
  method     String   @default("ACH") // CASH | CHECK | ACH | CARD | MONEY_ORDER | OTHER
  reference  String? // check number, confirmation code
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// A trade or service provider you dispatch work to.
model Vendor {
  id           String   @id @default(cuid())
  name         String
  trade        String   @default("GENERAL") // PLUMBING | ELECTRICAL | HVAC | APPLIANCE | GENERAL | LANDSCAPING | CLEANING | ROOFING | PEST | OTHER
  contactName  String?
  email        String?
  phone        String?
  hourlyRate   Float?
  insuredUntil DateTime?
  w9OnFile     Boolean  @default(false)
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workOrders WorkOrder[]
  expenses   Expense[]
}

// A maintenance request against a property or unit.
model WorkOrder {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId        String?
  unit          Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  vendorId      String?
  vendor        Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  category      String   @default("GENERAL") // PLUMBING | ELECTRICAL | HVAC | APPLIANCE | GENERAL | LANDSCAPING | CLEANING | ROOFING | PEST | TURNOVER | OTHER
  priority      String   @default("NORMAL") // LOW | NORMAL | HIGH | EMERGENCY
  status        String   @default("OPEN") // OPEN | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELLED
  reportedAt    DateTime @default(now())
  scheduledFor  DateTime?
  completedAt   DateTime?
  estimatedCost Float?
  actualCost    Float?
  billToTenant  Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expenses Expense[]
}

// An operating cost against a property. Feeds the owner statement.
model Expense {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  category    String   @default("REPAIRS") // REPAIRS | MAINTENANCE | TAXES | INSURANCE | UTILITIES | MORTGAGE | MGMT_FEE | LEGAL | SUPPLIES | TURNOVER | OTHER
  description String?
  amount      Float
  paidAt      DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId, paidAt])
}

// ===========================================================================
// FGW / AFLH COMMAND CENTER — SYNTHETIC PROTOTYPE ONLY
//
// Every model below is prefixed `Demo` and is written to ONLY by the demo
// seeder and the /command-center screens. Nothing here reads, writes or
// migrates production data, and no model above this line is modified.
//
// Money is stored in integer cents, not Float, so totals are exact. Divisions
// are a typed field ("FGW" | "AFLH") rather than separate tables, so one
// filter serves every screen.
//
// Deliberately absent: any clinical, medical, eligibility, date-of-birth,
// government-ID or payment-instrument field. Placements carry a fictional
// label and an occupancy status only.
// ===========================================================================

// A property (FGW) or licensed facility (AFLH).
model DemoProperty {
  id       String @id @default(cuid())
  sourceId String // the id this row would carry in the source system
  division String @default("FGW") // FGW | AFLH

  name        String
  addressLine String? // fictional
  city        String?
  state       String?

  // Typed license status, plus the raw source string it was mapped from.
  // Revenue eligibility is its OWN explicit field — never inferred from an
  // exact string match on the raw value (see domain.ts).
  licenseStatus    String  @default("UNKNOWN") // LICENSED | PROVISIONAL | PENDING_LICENSE | UNLICENSED | NOT_APPLICABLE | UNKNOWN
  licenseStatusRaw String? // what the source system had, verbatim
  revenueEligible  Boolean @default(false)

  // Configurable per property — NOT a hard-coded portfolio-wide constant.
  expectedFeesCents Int @default(0)

  bedCapacity Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checklistItems DemoChecklistItem[]
  placements     DemoPlacement[]
  referrals      DemoReferral[]
  tasks          DemoTask[]
  jobs           DemoJob[]
  workOrders     DemoWorkOrder[]
  moneyEntries   DemoMoneyEntry[]
  supplyItems    DemoSupplyItem[]

  @@unique([division, sourceId])
}

// A readiness/licensing checklist line against a property.
model DemoChecklistItem {
  id         String       @id @default(cuid())
  propertyId String
  property   DemoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  sourceId     String
  label        String
  category     String  @default("GENERAL") // SAFETY | DOCUMENTATION | FURNISHING | INSPECTION | GENERAL
  required     Boolean @default(true)
  status       String  @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | BLOCKED | COMPLETE
  evidenceNote String? // what the last check-in actually showed
  blockedReason String?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([propertyId, sourceId])
}

// Occupancy only. No personal, clinical or health detail by design.
model DemoPlacement {
  id         String       @id @default(cuid())
  propertyId String
  property   DemoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  sourceId     String
  occupantCode String // e.g. "DEMO-OCC-01" — a label, not a person
  displayLabel String // e.g. "Fictional Occupant A"
  status       String @default("RESERVED") // RESERVED | MOVED_IN | MOVED_OUT
  movedInAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([propertyId, sourceId])
}

// Administrative referral intake. Stages are fixed and administrative only:
// nothing here decides clinical admission or eligibility, and no stage may be
// advanced past HUMAN_REVIEW without a recorded human decision.
model DemoReferral {
  id       String @id @default(cuid())
  sourceId String
  division String @default("AFLH")

  referralCode  String
  referrerLabel String // fictional organisation or contact label
  stage         String @default("RECEIVED") // RECEIVED | FOLLOW_UP | DOCUMENTS_PENDING | HUMAN_REVIEW | HUMAN_DECISION_RECORDED | MOVE_IN_CHECKLIST

  propertyId String?
  property   DemoProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  // A decision is recorded, never computed. Both fields are set by a person.
  decisionRecordedBy String?
  decisionNote       String?
  decisionAt         DateTime?

  blocked       Boolean @default(false)
  blockedReason String?

  receivedAt DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([division, sourceId])
}

model DemoTask {
  id       String @id @default(cuid())
  sourceId String
  division String @default("FGW")

  title      String
  assignee   String? // fictional staff label
  status     String  @default("OPEN") // OPEN | IN_PROGRESS | BLOCKED | DONE | CANCELLED
  priority   String  @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  dueAt      DateTime?
  completedAt DateTime?
  blockedReason String?

  propertyId String?
  property   DemoProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([division, sourceId])
}

model DemoVendor {
  id       String @id @default(cuid())
  sourceId String
  division String @default("FGW")

  name  String
  trade String  @default("GENERAL")
  phone String? // fictional
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs         DemoJob[]
  moneyEntries DemoMoneyEntry[]

  @@unique([division, sourceId])
}

// A scoped piece of work with a cost. Money attaches to a job through the
// single canonical `DemoMoneyEntry.jobId` relation — there is no second,
// parallel link column.
model DemoJob {
  id       String @id @default(cuid())
  sourceId String
  division String @default("FGW")

  title  String
  status String @default("PLANNED") // PLANNED | APPROVED | IN_PROGRESS | COMPLETE | CANCELLED

  quotedCents   Int @default(0)
  approvedCents Int @default(0)

  propertyId String?
  property   DemoProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  vendorId   String?
  vendor     DemoVendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  blocked       Boolean @default(false)
  blockedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moneyEntries DemoMoneyEntry[]

  @@unique([division, sourceId])
}

// The money log. ONE canonical relationship per dimension: a row points at a
// property, a job and a vendor by a single FK each, never by two competing
// link columns.
model DemoMoneyEntry {
  id       String @id @default(cuid())
  sourceId String
  division String @default("FGW")

  kind       String @default("EXPENSE") // FEE_PAYMENT | EXPENSE | SUPPLY_PURCHASE | ADVANCE_REPAYMENT
  amountCents Int    @default(0)
  occurredAt DateTime
  memo       String?

  propertyId String?
  property   DemoProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  jobId      String?
  job        DemoJob?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  vendorId   String?
  vendor     DemoVendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([division, sourceId])
}

model DemoAdvance {
  id       String @id @default(cuid())
  sourceId String
  division String @default("FGW")

  label        String
  amountCents  Int @default(0)
  repaidCents  Int @default(0)
  issuedAt     DateTime
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([division, sourceId])
}

model DemoSupplyItem {
  id       String @id @default(cuid())
  sourceId String
  division String @default("FGW")

  name          String
  category      String @default("FURNISHING") // FURNISHING | APPLIANCE | CONSUMABLE | SAFETY | OTHER
  quantity      Int    @default(1)
  unitCostCents Int    @default(0)

  propertyId String?
  property   DemoProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([division, sourceId])
}

// Work orders carry an explicit source-ID field. The pair (division, sourceId)
// is unique, so a re-import cannot silently create a second copy; the importer
// reports duplicates instead (see reconcileBySourceId in domain.ts).
model DemoWorkOrder {
  id       String @id @default(cuid())
  sourceId String
  division String @default("FGW")

  title    String
  category String @default("GENERAL")
  priority String @default("NORMAL") // LOW | NORMAL | HIGH | EMERGENCY
  status   String @default("OPEN") // OPEN | ASSIGNED | IN_PROGRESS | COMPLETE | CANCELLED

  propertyId String?
  property   DemoProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  reportedAt    DateTime @default(now())
  completedAt   DateTime?
  estimateCents Int?
  actualCents   Int?
  blocked       Boolean @default(false)
  blockedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([division, sourceId])
}

model DemoSopReference {
  id       String @id @default(cuid())
  sourceId String
  division String @default("AFLH")

  title   String
  summary String?
  version String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([division, sourceId])
}

model DemoContact {
  id       String @id @default(cuid())
  sourceId String
  division String @default("FGW")

  displayName String // fictional
  role        String?
  org         String?
  phone       String? // fictional
  email       String? // @example.invalid only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([division, sourceId])
}

// An automation/agent's self-reported state. `lastEvidenceNote` is what it
// actually showed; `blocked` is authoritative over any claim in a note.
model DemoAgentCheckIn {
  id       String @id @default(cuid())
  /**
   * Immutable identity. Whiteboard card IDs are keyed on this, NOT on
   * agentName, so renaming an automation updates its existing card instead of
   * orphaning it and creating a second one.
   */
  sourceId String
  division String @default("FGW")

  /** Display label only. Safe to rename; never reaches the projection. */
  agentName        String
  scope            String
  lastCheckInAt    DateTime?
  lastEvidenceNote String?
  blocked          Boolean  @default(false)
  blockedReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([division, sourceId])
}

// The approval queue. A request can only be decided by a named person; the
// gate in domain.ts refuses approval while the subject is blocked.
model DemoApproval {
  id       String @id @default(cuid())
  division String @default("FGW")

  title       String
  subjectType String // PROPERTY | JOB | WORK_ORDER | REFERRAL | MONEY_ENTRY
  subjectId   String
  requestedBy String
  amountCents Int?

  state String @default("PENDING") // PENDING | APPROVED | REJECTED | WITHDRAWN

  decidedBy    String? // a person's name — never an agent
  decisionNote String?
  decidedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Append-only audit history for the prototype.
model DemoAuditEvent {
  id       String @id @default(cuid())
  division String @default("FGW")

  at          DateTime @default(now())
  actor       String
  actorKind   String   @default("HUMAN") // HUMAN | AGENT | SYSTEM
  action      String
  subjectType String?
  subjectId   String?
  detail      String?

  @@index([at])
}

// --- Whiteboard projection (synthetic, outbound-only) ----------------------
// Tracks the state of a one-way projection from the demo dataset to an
// external board. Nothing here contacts a network: a projection is generated
// locally and applied by a person. `enabled` is false and stays false.

model DemoWhiteboardTarget {
  id        String @id @default(cuid())
  targetKey String @unique // e.g. "ai-team-board"
  label     String
  targetUrl String // recorded for documentation; never fetched by this app
  /** Hard off. No code path in the prototype turns this on. */
  enabled   Boolean @default(false)

  // Last applied projection, for duplicate and stale rejection.
  lastAppliedVersion     Int?
  lastAppliedContentHash String?
  lastAppliedAt          DateTime?

  lastSuccessAt       DateTime?
  lastErrorAt         DateTime?
  lastError           String?
  consecutiveFailures Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events DemoWhiteboardEvent[]
}

// Append-only log of projection attempts and their outcome.
model DemoWhiteboardEvent {
  id       String               @id @default(cuid())
  targetId String
  target   DemoWhiteboardTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  at           DateTime @default(now())
  projectionId String
  version      Int
  contentHash  String
  generatedAt  DateTime
  outcome      String // APPLIED | REJECTED_DUPLICATE | REJECTED_STALE | REJECTED_VERSION_CONFLICT | REJECTED_UNKNOWN_TARGET | FAILED
  detail       String?

  @@index([targetId, at])
}
