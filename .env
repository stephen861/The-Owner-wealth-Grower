# SQLite database location. Change this if you want to store the DB elsewhere.
DATABASE_URL="file:./dev.db"

# ── FGW Leasing Agent ──────────────────────────────────────────────
# Claude API key for the AI leasing agent. Without it the agent runs in
# rules-only fallback mode (captures leads + escalates to staff).
ANTHROPIC_API_KEY=""
# Twilio — set the auth token to verify inbound webhook signatures.
TWILIO_AUTH_TOKEN=""
# Public base URL Twilio calls (used for signature verification).
PUBLIC_BASE_URL=""
# Shown to prospects when the agent hands off to a person.
FGW_OFFICE_PHONE="(555) 010-0100"
# Optional: send SMS replies asynchronously via Twilio REST (recommended —
# avoids Twilio's 15s webhook timeout). Without these, replies go back as TwiML.
TWILIO_ACCOUNT_SID=""
TWILIO_FROM_NUMBER=""
